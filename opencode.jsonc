{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["bun", "x", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["bun", "x", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "sequentialthinking": {
      "type": "local",
      "command": ["bun", "x", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    }
  }
}
